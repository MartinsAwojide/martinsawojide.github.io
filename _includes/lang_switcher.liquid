{% comment %}
  Language switcher dropdown for the navbar.
  Uses jekyll-polyglot's site.languages and page_lang.
  Displays flag emoji + language name for each configured language.
  Add this include inside header.liquid beside the dark mode toggle.
{% endcomment %}

{% assign lang_flags = "" %}
{% assign lang_names = "" %}

<div class="lang-switcher dropdown">
  <button
    class="btn lang-switcher-btn dropdown-toggle"
    type="button"
    id="langSwitcherBtn"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    aria-label="Select language"
  >
    {% case site.active_lang %}
      {% when "en" %}<span aria-hidden="true">🇬🇧</span> EN
      {% when "fr" %}<span aria-hidden="true">🇫🇷</span> FR
      {% when "es" %}<span aria-hidden="true">🇪🇸</span> ES
      {% when "pt-br" %}<span aria-hidden="true">🇧🇷</span> PT
      {% when "de" %}<span aria-hidden="true">🇩🇪</span> DE
      {% when "ja" %}<span aria-hidden="true">🇯🇵</span> JA
      {% when "zh-cn" %}<span aria-hidden="true">🇨🇳</span> ZH
      {% when "no" %}<span aria-hidden="true">🇳🇴</span> NO
      {% else %}<span aria-hidden="true">🌐</span> {{ site.active_lang | upcase }}
    {% endcase %}
  </button>
  <ul class="dropdown-menu dropdown-menu-end lang-switcher-menu" aria-labelledby="langSwitcherBtn">
    {% for lang in site.languages %}
      <li>
        <a
          class="dropdown-item lang-switcher-item{% if lang == site.active_lang %} active{% endif %}"
          href="/{{ lang }}/"
          hreflang="{{ lang }}"
        >
          {% case lang %}
            {% when "en" %}<span aria-hidden="true">🇬🇧</span> English
            {% when "fr" %}<span aria-hidden="true">🇫🇷</span> Français
            {% when "es" %}<span aria-hidden="true">🇪🇸</span> Español
            {% when "pt-br" %}<span aria-hidden="true">🇧🇷</span> Português (BR)
            {% when "de" %}<span aria-hidden="true">🇩🇪</span> Deutsch
            {% when "ja" %}<span aria-hidden="true">🇯🇵</span> 日本語
            {% when "zh-cn" %}<span aria-hidden="true">🇨🇳</span> 中文（简体）
            {% when "no" %}<span aria-hidden="true">🇳🇴</span> Norsk
            {% else %}{{ lang | upcase }}
          {% endcase %}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
