<!-- NEW: BuildwithHussein-style card with hover overlay + tag chips -->
<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-card-link">
    <div class="card h-100 hoverable project-card">
      <!-- Image with overlay -->
      <div class="project-card-img-wrap">
        {% if project.img %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes="250px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        {% else %}
          <div class="project-card-img-placeholder"></div>
        {% endif %}
        <!-- Hover overlay with description -->
        <div class="card-overlay" aria-hidden="true">
          <p class="card-overlay-text">{{ project.description }}</p>
        </div>
      </div>

      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text card-text-clamp">{{ project.description }}</p>

        <!-- Tag chips from project frontmatter tags: -->
        {% if project.tags and project.tags.size > 0 %}
          <div class="project-card-tags">
            {% for tag in project.tags limit: 4 %}
              <span class="project-card-tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}

        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
